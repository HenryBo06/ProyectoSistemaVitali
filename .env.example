# Copy to .env on the VM. Never commit the populated .env file.
SMARTORDER_DOMAIN=smartorder.internal
SMARTORDER_SECRET_KEY=replace-with-a-random-value-at-least-50-characters
SMARTORDER_SETUP_CODE=replace-with-a-separate-random-value-at-least-32-characters
SMARTORDER_HSTS_SECONDS=31536000
SMARTORDER_MAINTENANCE_UI=0

POSTGRES_DB=smartorder
POSTGRES_USER=smartorder
POSTGRES_PASSWORD=replace-with-a-random-url-safe-value
